  "cards": [
    {
      "dot": "cyan",
      "title": "One world pass",
      "items": [
        "MapScreen feeds VoxyMapCameraController; CameraMixin moves Minecraft's own camera and FOV to that pose, so Voxy renders the map in its normal pass",
        "VoxyClientMixin keeps Voxy's cached LODs in the near hand-off zone while the map is open, so terrain does not depend on the real camera's Sodium visibility set",
        "LevelMixin, CloudRendererMixin, WeatherEffectRendererMixin and ClientClockManagerMixin clear weather and clouds and apply the map lighting setting"
      ]
    },
    {
      "dot": "emerald",
      "title": "Anti-xray by construction",
      "items": [
        "VoxyShaderPatcher string-patches quads3.vert and quads.frag; the Nether roof is removed by discarding whole quads above a cut height, never by a fragment plane",
        "OreMaskController marks vanilla ore and ancient debris models; the fragment shader paints them grey wherever Voxy draws them",
        "If the shader markers are missing, patchSafely() leaves Voxy untouched and both features switch off"
      ]
    },
    {
      "dot": "violet",
      "title": "Waypoints, sync and sharing",
      "items": [
        "VoxyMapPicker ray-picks the visible voxel off the render thread; pins are local or shared per waypoint",
        "voxymap-sync-server stores shared pins as JSON per Voxy world and relays map shares without storing them",
        "VoxySectionBridge imports only empty sections and translates block and biome ids through Voxy's mapper"
      ]
    },
    {
      "dot": "amber",
      "title": "Two jars from one build",
      "items": [
        "voxy-map-<version>.jar is the release build and leaves the playerMarkers source set out; RemotePlayerMarkers finds no class and the players row disappears",
        "voxy-map-<version>-player-markers.jar (task playerMarkersJar) adds that source set",
        "Iris and SpatialGui mixins apply only when their mod is loaded (VoxyMapMixinPlugin); Xaero is reached by reflection"
      ]
    }
  ]
