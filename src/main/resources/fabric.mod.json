{
  "schemaVersion": 1,
  "id": "voxymap",
  "version": "${version}",
  "name": "VoxyMap LTS",
  "icon": "assets/voxymap/icon.png",
  "description": "Full-screen world map addon for Voxy LOD mod. Renders explored terrain using Voxy's LOD data.",
  "authors": ["LTS_Server"],
  "contributors": ["raben12paste"],
  "contact": {
    "sources": "https://github.com/raben12paste/3D-maps-Voxy-Addon"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.voxymap.client.VoxyMapClient"
    ]
  },
  "mixins": [
    "voxymap.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "java": ">=25",
    "fabric-api": "*",
    "voxy": ">=0.2.18-beta"
  },
  "suggests": {
    "iris": "*",
    "xaeroworldmap": ">=1.45.0"
  },
  "custom": {
    "modmenu": {
      "links": {}
    }
  }
}
